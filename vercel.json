{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "app.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/app.py?__path=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/app.py?__path=/api/$1"
    },
    {
      "source": "/uploads",
      "destination": "/app.py?__path=/uploads/"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/app.py?__path=/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
